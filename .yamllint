---
extends: default

rules:
  line-length:
    max: 120
    level: warning

  comments-indentation: false

  comments:
    min-spaces-from-content: 1

  braces:
    max-spaces-inside: 1

  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true

ignore: |
  .venv/
  collections/
  .git/
  .fact_cache/
